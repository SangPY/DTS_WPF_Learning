<Window x:Class="DTS_WPF_Learning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DTS_WPF_Learning"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="800">

  
    <Grid>
        <!-- Hiển thị hình ảnh -->
        <Image x:Name="DisplayImage" Width="500" Height="600" />

        <!-- Chấm trắng ở giữa ảnh -->
        <Ellipse x:Name="CenterDot" Width="10" Height="10" Fill="White"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 MouseDown="CenterDot_MouseDown"
                 MouseMove="CenterDot_MouseMove"
                 MouseUp="CenterDot_MouseUp"/>

        <!-- Nút chuyển sang hình ảnh tiếp theo -->
        <!--<Button Content="Next Image" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                Width="100" Height="30" Click="NextImage_Click"/>-->
    </Grid>
</Window>
